# Chỉ đồng bộ bộ nhớ (memory) và script đồng bộ. Mọi thứ khác bị bỏ qua.
*

!.gitignore
!projects/
!projects/*/
!projects/*/memory/
!projects/*/memory/**
!scripts/
!scripts/**

# File sao lưu tạm trong memory (nếu có)
*.bak*

# Thư mục memory riêng của máy bàn (liên kết tới C--Users-PC)
/projects/C--Users-Admin/
